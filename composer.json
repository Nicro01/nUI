{
    "name": "nicro/nui",
    "description": "Componentes Blade para a TALL Stack com tokens OKLCH e controles nativos.",
    "keywords": ["laravel", "tall-stack", "blade", "livewire", "alpinejs", "tailwindcss", "ui", "components"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "nicro",
            "role": "Developer"
        }
    ],
    "require": {
        "bacon/bacon-qr-code": "~3.0",
        "php": "^8.2|^8.3|^8.4",
        "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
        "illuminate/view": "^10.0|^11.0|^12.0|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Nicro\\Nui\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Nicro\\Nui\\NuiServiceProvider"
            ]
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
